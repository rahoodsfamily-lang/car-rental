# ==============================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to GitHub!

# Server Configuration
NODE_ENV=production
PORT=5000

# Database Configuration (MongoDB Atlas)
# Get this from MongoDB Atlas after creating your cluster
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/carRental?retryWrites=true&w=majority
# For local MongoDB: mongodb://localhost:27017/car-rental

# JWT Configuration (IMPORTANT: Change this!)
# Generate a secure key: Use a random string generator (32+ characters)
JWT_SECRET=your-super-secure-jwt-secret-key-minimum-32-characters
JWT_EXPIRE=7d

# CORS Configuration (Your Frontend URL)
# Update this with your Vercel/Netlify URL after deployment
CLIENT_URL=https://your-frontend-app.vercel.app
# For local development: http://localhost:3000

# Email Configuration (SendGrid API)
# Get API key from SendGrid dashboard: https://sendgrid.com
# Free tier: 100 emails/day forever
EMAIL_SERVICE=sendgrid
EMAIL_PASS=your-sendgrid-api-key
EMAIL_FROM="Car Rental System <noreply@yourdomain.com>"
# Note: If EMAIL_SERVICE is not set or SendGrid not configured, 
# system will automatically use Ethereal (test mode) for development

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ==============================================
# DATABASE CONFIGURATION
# ==============================================

# Local MongoDB (Development)
DB_URI=mongodb://localhost:27017/car-rental

# MongoDB Atlas (Production) - Uncomment to use cloud database
#MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/carRental?retryWrites=true&w=majority

# ==============================================
# SERVER CONFIGURATION
# ==============================================

JWT_SECRET=your-jwt-secret-key-change-this-in-production
PORT=5000
FRONTEND_URL=http://localhost:3000

# ==============================================
# EMAIL CONFIGURATION
# ==============================================

# Option 1: SendGrid (Recommended for production)
# Uncomment these lines to use SendGrid
#EMAIL_SERVICE=sendgrid
#EMAIL_USER=apikey
#EMAIL_PASS=your-sendgrid-api-key
#EMAIL_FROM="Car Rental System <your-email@gmail.com>"

# Option 2: Ethereal (Development/Testing - Default)
# No configuration needed - emails will be caught by Ethereal
# View test emails at: https://ethereal.email
EMAIL_FROM="Car Rental System <noreply@carrentalsystem.com>"

# ==============================================
# CLOUDINARY CONFIGURATION (Optional)
# ==============================================

# For image uploads - Get these from Cloudinary dashboard
CLOUDINARY_NAME=your-cloud-name
CLOUDINARY_KEY=your-api-key
CLOUDINARY_SECRET=your-api-secret

# ==============================================
# SESSION CONFIGURATION
# ==============================================

SESSION_SECRET=your-session-secret-change-this-in-production

# ==============================================
# DEPLOYMENT CHECKLIST:
# 1. Copy this file to .env
# 2. Fill in all required values
# 3. NEVER commit .env to GitHub
# 4. Add these same variables to Railway/Render
# ==============================================
ADMIN_PASSWORD=Admin123!

# Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_IN_APP_NOTIFICATIONS=true

# Booking Settings
BOOKING_REMINDER_DAYS=1
OVERDUE_CHECK_INTERVAL_HOURS=1
